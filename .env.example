# ==============================================================================
# SYSFOOD SAAS - MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# NUNCA insira chaves reais de produção ou staging neste arquivo versionado no Git.
# ==============================================================================

# Supabase (Staging / Produção)
NEXT_PUBLIC_SUPABASE_URL=https://[ID_DO_SEU_PROJETO].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...[sua-anon-key-publica]
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...[sua-service-role-key-privada-servidor-apenas]

# Configuração da Aplicação
APP_ENV=development # development | staging | production
NODE_ENV=development
NEXT_PUBLIC_APP_DOMAIN=localhost:3000

# Analytics & Observabilidade (Opcional - Pode ser definido dinamicamente por Tenant)
NEXT_PUBLIC_DEFAULT_GA4_ID=
